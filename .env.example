# ===== إعدادات الاتصال بالـ Backend =====
# عنوان الـ API الأساسي (مثال لـ ASP.NET Core). لا تضع أي أسرار هنا؛
# كل متغيرات VITE_ تُضمَّن في كود المتصفح وتكون مرئية للجميع.
VITE_API_BASE_URL=https://api.example.com/api

# مهلة الطلب بالمللي ثانية
VITE_API_TIMEOUT=15000

# وضع العرض التجريبي: true = بيانات تجريبية محلية (لا يوجد Backend)
#                     false = الاتصال بالـ Backend الحقيقي عبر VITE_API_BASE_URL
VITE_USE_MOCK=true

# (وضع Demo فقط) نسبة محاكاة أخطاء الشبكة من 0 إلى 1 لاختبار حالات الخطأ
VITE_MOCK_ERROR_RATE=0
